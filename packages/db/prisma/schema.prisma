generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Website {
  id        String        @id @default(uuid())
  url       String
  timeAdded DateTime
  tick      WebsiteTick[]
}

model Region {
  id    String        @id @default(uuid())
  name  String
  ticks WebsiteTick[]
}

model WebsiteTick {
  id              String        @id @default(uuid())
  responseTime_ms Int
  status          WebsiteStatus

  regionId  String
  websiteId String

  region  Region  @relation(fields: [regionId], references: [id])
  website Website @relation(fields: [websiteId], references: [id])
}

enum WebsiteStatus {
  Up
  Down
  Unknown
}
