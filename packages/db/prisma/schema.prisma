generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String
  password String
  websites Website[]
}

model Website {
  id        String        @id @default(uuid())
  user_id   String
  user      User          @relation(fields: [user_id], references: [id])
  url       String
  timeAdded DateTime      @default(now())
  tick      WebsiteTick[]
}

model Region {
  id    String        @id @default(uuid())
  name  String
  ticks WebsiteTick[]
}

model WebsiteTick {
  id              String        @id @default(uuid())
  responseTime_ms Int
  status          WebsiteStatus

  regionId  String
  websiteId String

  region  Region  @relation(fields: [regionId], references: [id])
  website Website @relation(fields: [websiteId], references: [id])
}

enum WebsiteStatus {
  Up
  Down
  Unknown
}
